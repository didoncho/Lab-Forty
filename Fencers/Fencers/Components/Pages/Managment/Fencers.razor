@page "/Fencers"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text.Json
@using CsvHelper
@using ServiceLayer
@using ServiceLayer.DTOs
@using ServiceLayer.Helpers
@using ServiceLayer.Mappers
@inject FencerService fencerService
@inject CoachService coachService
@rendermode InteractiveServer
@inject IJSRuntime JS

<h3>Fencers</h3>

<table class="table table-striped">
    <thead>
    <tr>
        <td>Name</td>
        <td>UID</td> 
        <td>Date of birth</td>
        <td>EGN</td>
        <td>Birth place</td>
        <td>Address</td>
        <td>Coach</td>
    </tr>
    </thead>
    
    @foreach (var f in fencers)
    {
        <tr>
            <td>@f.Name</td>
            <td>@f.UID</td>
            <td>@f.DateOfBirth</td>
            <td>@f.Egn</td>
            <td>@f.BirthPlace</td>
            <td>@f.Address</td>
            <td>@coaches.FirstOrDefault(c => c.Id == f.CoachId)?.Name</td>
            <td><button @onclick="async (_) => await OnDelete(f.Id)">Delete</button></td>
            <td><button @onclick="async (_) => await UpdateFencer(f)">Update</button></td>
        </tr>
    }
</table>

<button @onclick="ShowModal">@(ShowAdd ? "Close" : "Open")</button>
<button @onclick="async () => await DownloadFileFromStream()">Download</button>

@if (ShowAdd)
{

    <h3>@(isEditing ? "Edit fencer information" : "Add fencer")</h3>

    <EditForm Model="newFencer" OnValidSubmit="AddFencer" class="form-control">
        <DataAnnotationsValidator/>

        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="newFencer.Name"/>
            <ValidationMessage For="() => newFencer.Name"/>
        </div>
        
        <div class="mb-3">
            <label class="form-label" for="uid">UID</label>
            <InputNumber id="name" class="form-control" @bind-Value="newFencer.UID"/>
            <ValidationMessage For="() => newFencer.UID"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="dateOfBirth">Date of birth</label>
            <InputDate id="dateOfBirth" class="form-control" @bind-Value="newFencer.DateOfBirth"/>
            <ValidationMessage For="() => newFencer.DateOfBirth"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="egn">EGN</label>
            <InputText id="egn" class="form-control" @bind-Value="newFencer.Egn"/>
            <ValidationMessage For="() => newFencer.Egn"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="BirthPlace">Birth place</label>
            <InputText id="BirthPlace" class="form-control" @bind-Value="newFencer.BirthPlace"/>
            <ValidationMessage For="() => newFencer.BirthPlace"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="Address">Address</label>
            <InputText id="Address" class="form-control" @bind-Value="newFencer.Address"/>
            <ValidationMessage For="() => newFencer.Address"/>
        </div>
        
        <div class="mb-3">
            <label class="form-label" for="Coach">Coach</label>
            <select @bind=@newFencer.CoachId>
                @foreach (var u in coaches)
                {
                    <option value=@u.Id>@u.Name</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">@(isEditing ? "Edit information" : "Add fencer")</button>
    </EditForm>
}

<script>
  window.downloadFileFromStream = async (fileName, contentStreamReference) => {
      const arrayBuffer = await contentStreamReference.arrayBuffer();
      const blob = new Blob([arrayBuffer]);
      const url = URL.createObjectURL(blob);
      const anchorElement = document.createElement('a');
      anchorElement.href = url;
      anchorElement.download = fileName ?? '';
      anchorElement.click();
      anchorElement.remove();
      URL.revokeObjectURL(url);
  }  
</script>

@code {
    public bool ShowAdd = false;
    public bool isEditing => newFencer.Id != 0;
    
    FencerDTO newFencer = new();

    private void ShowModal()
    {
        ShowAdd = !ShowAdd;
        
        if (!ShowAdd)
        {
            newFencer = new FencerDTO();
        }
    }

    private async Task AddFencer()
    {
        if(isEditing)
            await fencerService.UpdateFencerAsync(newFencer.Id, newFencer.Name, newFencer.UID, newFencer.DateOfBirth,  newFencer.Egn, newFencer.BirthPlace, newFencer.Address);
        else
            await fencerService.CreateFencerAsync(newFencer);
        newFencer = new();
        fencers = await fencerService.GetAllFencersAsync();
    }
    
    protected override async Task OnInitializedAsync()
    {
        if (fencers.Count == 0)
        {
            fencers = await fencerService.GetAllFencersAsync();
        }

        if (coaches.Count == 0)
        {
            coaches = await coachService.GetAllAttachCoachesAsync();
        }
        //return base.OnInitializedAsync();
    }

    private async Task OnDelete(int id)
    {
        await fencerService.DeleteFencerAsync(id);
        fencers = await fencerService.GetAllFencersAsync();
    }

    private async Task UpdateFencer(FencerDTO fencer)
    {
        newFencer = JSONHelper.DeepCopy(fencer);
        ShowAdd = true;
    }
    
    private Stream GetFileStream(string text)
    {
        var randomBinaryData = new byte[50 * 1024];
        var fileStream = new MemoryStream(randomBinaryData);

        return fileStream;
    }

    private async Task DownloadFileFromStream()
    {
        var fencerExportData = fencers.Select(f => new
        {
            f.Id,
            f.Name,
            f.UID,
            f.DateOfBirth,
            f.Egn,
            f.BirthPlace,
            f.Address,
            Coach = coaches.FirstOrDefault(c => c.Id == f.CoachId)?.Name
        });
        
        using (var writer = new StreamWriter("fencers.csv"))
        {
            using (var csv = new CsvWriter(writer, CultureInfo.InvariantCulture))
            {
                csv.WriteRecords(fencerExportData);
            }
        }
        
        byte[] data = File.ReadAllBytes("fencers.csv");
        MemoryStream stream = new MemoryStream(data);
        
        
        using var streamRef = new DotNetStreamReference(stream: stream);

        await JS.InvokeVoidAsync("downloadFileFromStream", "fencers.csv", streamRef);
    }

    List<FencerDTO> fencers = [];
    List<AttachCoachDTO> coaches = [];
}