@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Runtime.CompilerServices
@using System.Text.Json
@using CsvHelper
@using ServiceLayer
@using ServiceLayer.DTOs
@using ServiceLayer.Helpers
@using ServiceLayer.Mappers
@page "/Coaches"
@inject CoachService coachService
@rendermode InteractiveServer
@inject IJSRuntime JS

<h3>Coaches</h3>

<table class="table table-striped">
    <thead>
    <tr>
        <td>Name</td>
        <td>Date of birth</td>
        <td>EGN</td>
        <td>Birth place</td>
        <td>Address</td>
    </tr>
    </thead>
    
    @foreach (var c in coaches)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.DateOfBirth</td>
            <td>@c.Egn</td>
            <td>@c.BirthPlace</td>
            <td>@c.Address</td>
            <td><button @onclick="async (_) => await OnDelete(c.Id)">Delete</button></td>
            <td><button @onclick="async (_) => await UpdateCoach(c)">Update</button></td>
        </tr>
    }
</table>

<button @onclick="ShowModal">@(ShowAdd ? "Close" : "Open")</button>
<button @onclick="async () => await DownloadFileFromStream()">Download</button>

@if (ShowAdd)
{

    <h3>@(isEditing ? "Edit coach information" : "Add coach")</h3>

    <EditForm Model="newCoach" OnValidSubmit="AddCoach" class="form-control">
        <DataAnnotationsValidator/>

        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="newCoach.Name"/>
            <ValidationMessage For="() => newCoach.Name"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="dateOfBirth">Date of birth</label>
            <InputDate id="dateOfBirth" class="form-control" @bind-Value="newCoach.DateOfBirth"/>
            <ValidationMessage For="() => newCoach.DateOfBirth"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="egn">EGN</label>
            <InputText id="egn" class="form-control" @bind-Value="newCoach.Egn"/>
            <ValidationMessage For="() => newCoach.Egn"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="BirthPlace">Birth place</label>
            <InputText id="BirthPlace" class="form-control" @bind-Value="newCoach.BirthPlace"/>
            <ValidationMessage For="() => newCoach.BirthPlace"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="Address">Address</label>
            <InputText id="Address" class="form-control" @bind-Value="newCoach.Address"/>
            <ValidationMessage For="() => newCoach.Address"/>
        </div>

        <button type="submit" class="btn btn-primary">@(isEditing ? "Edit information" : "Add coach")</button>
    </EditForm>
}
<script>
  window.downloadFileFromStream = async (fileName, contentStreamReference) => {
      const arrayBuffer = await contentStreamReference.arrayBuffer();
      const blob = new Blob([arrayBuffer]);
      const url = URL.createObjectURL(blob);
      const anchorElement = document.createElement('a');
      anchorElement.href = url;
      anchorElement.download = fileName ?? '';
      anchorElement.click();
      anchorElement.remove();
      URL.revokeObjectURL(url);
  }  
</script>


@code {
    public bool ShowAdd = false;
    public bool isEditing => newCoach.Id != 0;
    
    CoachDTO newCoach = new();

    private void ShowModal()
    {
        ShowAdd = !ShowAdd;

        if (!ShowAdd)
        {
            newCoach = new CoachDTO();
        }
    }

    private async Task AddCoach()
    {
        if(isEditing)
            await coachService.UpdateCoachAsync(newCoach.Id, newCoach.Name, newCoach.DateOfBirth,  newCoach.Egn, newCoach.BirthPlace, newCoach.Address);
        else
            await coachService.CreateCoachAsync(newCoach);
        
        newCoach = new();
        coaches = await coachService.GetAllCoachesAsync();
    }
    
    protected override async Task OnInitializedAsync()
    {
        if (coaches.Count == 0)
        {
            coaches = await coachService.GetAllCoachesAsync();
        }
        //return base.OnInitializedAsync();
    }
    
    private async Task OnDelete(int id)
    {
        await coachService.DeleteCoachAsync(id);
        coaches = await coachService.GetAllCoachesAsync();
    }

    private async Task UpdateCoach(CoachDTO coach)
    {
        newCoach = JSONHelper.DeepCopy(coach);
        ShowAdd = true;
    }
    
    private Stream GetFileStream(string text)
    {
        var randomBinaryData = new byte[50 * 1024];
        var fileStream = new MemoryStream(randomBinaryData);

        return fileStream;
    }

    private async Task DownloadFileFromStream()
    {
        using (var writer = new StreamWriter("coaches.csv"))
        {
            using (var csv = new CsvWriter(writer, CultureInfo.InvariantCulture))
            {
                csv.WriteRecords(coaches);
            }
        }
        
        byte[] data = File.ReadAllBytes("coaches.csv");
        MemoryStream stream = new MemoryStream(data);
        
        
        using var streamRef = new DotNetStreamReference(stream: stream);

        await JS.InvokeVoidAsync("downloadFileFromStream", "coaches.csv", streamRef);
    }

    List<CoachDTO> coaches = [];
}