@page "/Competitions"
@using System.Globalization
@using CsvHelper
@using CsvHelper.TypeConversion
@using DatabaseLayer
@using ServiceLayer
@using ServiceLayer.DTOs
@using ServiceLayer.Helpers
@using ServiceLayer.Mappers
@inject CompetitionService competitionService
@inject CompetitionResultService resultService
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject CsvImportService Importer

<h3>Competitions</h3>

<table class="table table-striped">
    <thead>
    <tr>
        <td>Name</td>
        <td>Date</td> 
        <td>Results</td>
    </tr>
    </thead>
    
    @foreach (var c in competitions)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.Date</td>
            <td><button @onclick="async (_) => await OnViewResults(c.Id)">View</button></td>
            <td><button @onclick="async (_) => await OnDelete(c.Id)">Delete</button></td>
            <td><button @onclick="async (_) => await UpdateFencer(c)">Update</button></td>
            <td>
                
<InputFile id="csv" OnChange="@(async (InputFileChangeEventArgs e) => await OnFileSelectedAsync(e, c.Id))" accept=".csv,text/csv" class="form-control" />
                
            </td>
        </tr>
    }
</table>

<button @onclick="ShowModal">@(ShowAdd ? "Close" : "Open")</button>
<button @onclick="async () => await DownloadFileFromStream()">Download template</button>

@if (ShowAdd)
{

    <h3>@(isEditing ? "Edit competition information" : "Add competition")</h3>

    <EditForm Model="newCompetition" OnValidSubmit="AddCompetition" class="form-control">
        <DataAnnotationsValidator/>

        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="newCompetition.Name"/>
            <ValidationMessage For="() => newCompetition.Name"/>
        </div>
        
        <div class="mb-3">
            <label class="form-label" for="name">Date</label>
            <InputDate id="date" class="form-control" @bind-Value="newCompetition.Date"/>
            <ValidationMessage For="() => newCompetition.Date"/>
        </div>
        
        <button type="submit" class="btn btn-primary">@(isEditing ? "Edit information" : "Add competition")</button>
    </EditForm>
}

@if (showResultsModal)
{
    <!-- Backdrop layer -->
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                
                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title">Competition Results</h5>
                    <button type="button" class="btn-close" @onclick="CloseResultsModal"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body">
                    @if (selectedResults != null && selectedResults.Any())
                    {
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Points</th> 
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in selectedResults)
                                {
                                    <tr>
                                        <td>@result.Rank</td>
                                        <td>@result.Points</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            No results found for this competition.
                        </div>
                    }
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseResultsModal">Close</button>
                </div>

            </div>
        </div>
    </div>
}

<script>
  window.downloadFileFromStream = async (fileName, contentStreamReference) => {
      const arrayBuffer = await contentStreamReference.arrayBuffer();
      const blob = new Blob([arrayBuffer]);
      const url = URL.createObjectURL(blob);
      const anchorElement = document.createElement('a');
      anchorElement.href = url;
      anchorElement.download = fileName ?? '';
      anchorElement.click();
      anchorElement.remove();
      URL.revokeObjectURL(url);
  }  
</script>

@if (competitionResults.Count > 0)
{
    <p>Parsed <strong>@competitionResults.Count</strong> rows from @fileName.</p>

    <table class="table table-sm table-striped">
        <thead>
        <tr>
            <th>Rank</th><th>Points</th>
            <th>Fencer UID</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var competitionResult in competitionResults)
        {
            <tr>
                <td>@competitionResult.Rank</td>
                <td>@competitionResult.Points</td>
                <td>@competitionResult.FencerUID</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    public bool ShowAdd = false;
    public bool isEditing => newCompetition.Id != 0;
    List<CompetitionDTO> competitions = new();

    private bool showResultsModal = false;
    private int selectedCompetitionId;
    private List<CompetitionResultDTO> selectedResults = new();

    CompetitionDTO newCompetition = new();

    private void ShowModal()
    {
        ShowAdd = !ShowAdd;

        if (!ShowAdd)
        {
            newCompetition = new CompetitionDTO();
        }
    }

    private async Task AddCompetition()
    {
        if (isEditing)
            await competitionService.UpdateCompetitionAsync(newCompetition.Id, newCompetition.Name, newCompetition.Date);
        else
            await competitionService.CreateCompetitionAsync(CompetitionMapper.ToBusiness(newCompetition));

        newCompetition = new();
        await LoadCompetitions();
    }

    protected override async Task OnInitializedAsync()
    {
        if (competitions.Count == 0)
        {
            await LoadCompetitions();
        }
        //return base.OnInitializedAsync();
    }

    private async Task OnDelete(int id)
    {
        await competitionService.DeleteCompetitionAsync(id);
        await LoadCompetitions();
    }

    private async Task UpdateFencer(CompetitionDTO competition)
    {
        newCompetition = JSONHelper.DeepCopy(competition);
        ShowAdd = true;
    }

    private async Task OnViewResults(int competitionId)
    {
        selectedCompetitionId = competitionId;
        selectedResults = await resultService.GetResultsByCompetitionIdAsync(competitionId);
        showResultsModal = true;
    }

    private void CloseResultsModal()
    {
        showResultsModal = false;
    }

    private async Task LoadCompetitions()
    {
        competitions = await competitionService.GetAllCompetitionsAsync();
    }

    private async Task DownloadFileFromStream()
    {
        var competitionExport = new List<CompetitionResultDTO>();
        
        using (var writer = new StreamWriter("competition.csv"))
        {
            using (var csv = new CsvWriter(writer, CultureInfo.InvariantCulture))
            {
                csv.WriteRecords(competitionExport);
            }
        }
        
        byte[] data = File.ReadAllBytes("competition.csv");
        MemoryStream stream = new MemoryStream(data);
        
        
        using var streamRef = new DotNetStreamReference(stream: stream);

        await JS.InvokeVoidAsync("downloadFileFromStream", "competition.csv", streamRef);
    }
    
    private string? fileName;
    private string? errorMessage;
    private bool isBusy;
    private const long MaxFileSize = 10L * 1024 * 1024; // 10 MB
    private List<CompetitionResultDTO> competitionResults = new();

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e, int competitionId)
    {
        isBusy = true;
        errorMessage = null;
        fileName = e.File.Name;

        try
        {
            // Buffer the browser stream: CsvHelper needs synchronous, seekable reads.
            await using var buffer = new MemoryStream();
            await using (var source = e.File.OpenReadStream(MaxFileSize))
            {
                await source.CopyToAsync(buffer);
            }
            buffer.Position = 0;

            competitionResults = (await Importer.ReadAsync<CompetitionResultDTO>(buffer)).ToList();
            if (competitionResults.Any())
            {
                foreach (var r in competitionResults)
                {
                    r.CompetitionId = competitionId;
                }
                await resultService.SaveCompetitionResultsAsync(competitionResults);
            }
        }
        catch (IOException ex)
        {
            errorMessage = $"That file is larger than the {MaxFileSize / 1024 / 1024} MB limit. ({ex.Message})";
        }
        catch (HeaderValidationException)
        {
            errorMessage = "The file is missing one or more expected columns. "
                           + "Expected: Id, First Name, Last Name, Email, Hire Date, Salary.";
        }
        catch (TypeConverterException ex)
        {
            errorMessage = $"Row {ex.Context?.Parser?.Row}: '{ex.Text}' is not a valid "
                           + $"{ex.MemberMapData.Member?.Name}.";
        }
        finally
        {
            isBusy = false;
        }
    }
}